{
  "name": "@figranium/embed",
  "version": "0.1.0",
  "description": "Zero-host, read-only Figranium task embeds rendered inside package-created iframes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figranium/figranium-embed.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync:figranium": "node scripts/sync-figranium.mjs",
    "build:document": "vite build --config vite.iframe.config.ts && node scripts/generate-srcdoc.mjs",
    "prebuild": "npm run sync:figranium && npm run build:document",
    "build": "tsc -p tsconfig.json && vite build",
    "pretypecheck": "npm run sync:figranium && npm run build:document",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.8",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
